# 本地开发用 development，部署到 HTTPS 生产站点时用 production。
APP_ENV=production
SECRET_KEY=
ADMIN_PASSWORD_HASH=
SITE_URL=https://peixin.uno
CORS_ORIGINS=https://peixin.uno
# 仅后端绑定 127.0.0.1、前方只有一层可信 Nginx 时开启。
TRUST_PROXY=true
# PUBLIC_DIR=/www/wwwroot/public
# DATABASE_URL=sqlite:////www/wwwroot/backend/blog.db
